# Copy to .env.local and fill in. Leave SHOPIFY_STORE_DOMAIN empty to browse
# the mock.shop demo catalog instead of your own store.

# Your store's myshopify.com domain (no https://)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API public access token.
# Shopify admin → Sales channels → Headless (or Settings → Apps → Develop apps)
# → Storefront API → Public access token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token-here

# Optional: Storefront API version (defaults to 2026-10)
# SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Optional: signing secret for the /api/revalidate webhook endpoint
# (Shopify admin → Settings → Notifications → Webhooks).
# SHOPIFY_WEBHOOK_SECRET=

# Optional: Admin API access token for "Join the CIRE List" sign-ups.
# Shopify admin → Settings → Apps → Develop apps → create an app with the
# read_customers and write_customers Admin API scopes.
# SHOPIFY_ADMIN_ACCESS_TOKEN=
